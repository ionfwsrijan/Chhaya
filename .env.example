# Copy to .env and adjust. `make local` works with none of these set.
# AWS mode (`CHHAYA_MODE=aws`) is what the SAM template sets in production.

# CHHAYA_MODE=local            # local | aws
# CHHAYA_SOURCE=fake           # fake | recorded | openmeteo
# CHHAYA_RECORDING=            # used when SOURCE=recorded
# CHHAYA_STORE_DIR=.chhaya     # JSON store directory (local mode)
# CHHAYA_AGENT=local           # local | bedrock
# CHHAYA_NOTIFIER=console      # console | log | sns
# CHHAYA_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# CHHAYA_DYNAMO_TABLE=chhaya-heat
# CHHAYA_SNS_TOPIC_ARN=
# CHHAYA_POLICY=policies/heat_policy_v1.yaml
# AWS_REGION=ap-south-1